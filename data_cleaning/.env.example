# Azure Blob Storage for the "guardar datos en el azure" step (cleaning_agent).
# Set ONE of them in your shell or a local .env (never commit real values).
# Recommended: account URL + Azure AD (az login / managed identity), no secret needed.
AZURE_STORAGE_ACCOUNT_URL=https://${STORAGE_ACCOUNT}.blob.core.windows.net
# Fallback only:
AZURE_STORAGE_CONNECTION_STRING=${AZURE_STORAGE_CONNECTION_STRING}
