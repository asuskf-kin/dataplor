# Azure Blob Storage for every upload/download of the agent (cleaning_agent).
# Copy to .env (git-ignored) and set ONE of them. Never commit real values.
# Recommended: account URL + Azure AD (az login / managed identity), no secret needed.
AZURE_STORAGE_ACCOUNT_URL=https://${STORAGE_ACCOUNT}.blob.core.windows.net
# Fallback only:
AZURE_STORAGE_CONNECTION_STRING=${AZURE_STORAGE_CONNECTION_STRING}

# Priorización runs in its own repo (../../Priorizacion_On_Premise_code) with its OWN .env
# (AZURE_STORAGE_CONNECTION_STRING, or AZURE_STORAGE_ACCOUNT + AZURE_STORAGE_KEY / AZURE_STORAGE_SAS_TOKEN):
# set it there, see that repo's README. This repo never reads it.
